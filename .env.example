# Copy to .env (git-ignored) and fill in. Never commit real values.

# AI model used for diagram analysis (image-capable model)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=network-config-jobs

# SSH to routers (management network provided by the instructor)
# Prefer a key file over passwords. Leave the password empty if you use a key.
SSH_USERNAME=
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=
SSH_PASSWORD=
SSH_ENABLE_PASSWORD=
SSH_TIMEOUT_SECONDS=10

# Interfaces the worker must never touch (comma separated), for example the management interface
MGMT_INTERFACES=

# Set to 1 to test the worker without sending anything to the routers
DRY_RUN=0